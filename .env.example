# ============================================
# LuminaFlow ERP - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# ============================================

# --- Supabase ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
# Legacy alias (optional):
VITE_SUPABASE_ANON_KEY=your-publishable-key-here

# Used by the Express backend (server/)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
SUPABASE_SECRET_KEY=your-secret-key-here
# Legacy aliases (optional):
SUPABASE_ANON_KEY=your-publishable-key-here
SUPABASE_SERVICE_ROLE_KEY=your-secret-key-here

# --- 2FA (TOTP) ---
# Chave dedicada para criptografia de segredos 2FA. Nunca reutilize uma chave
# de acesso ao Supabase. Em produção, defina uma chave AES-256 dedicada.
TOTP_ENCRYPTION_KEY=

# Opcional e temporária: chave usada ANTES da rotação acima. Ao validar um
# código 2FA legado, o segredo é recriptografado com TOTP_ENCRYPTION_KEY.
# Remova esta variável depois que todos os usuários ativos entrarem novamente.
TOTP_PREVIOUS_ENCRYPTION_KEY=

# Assinatura dos links públicos de anamnese. Deve ser independente das chaves
# do Supabase e permanecer estável durante a validade dos links emitidos.
ANAMNESE_TOKEN_SECRET=

# Assinatura de tokens temporários para consulta pública de pagamento.
# Não use SUPABASE_SERVICE_ROLE_KEY como fallback.
PAYMENT_STATUS_TOKEN_SECRET=

# --- Server ---
PORT=8787
NODE_ENV=development

# --- Mercado Pago ---
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=

# --- API URLs ---
# Frontend uses this to know where the Express backend is
VITE_API_BASE_URL=http://localhost:8787

# --- CORS ---
# Comma-separated list of allowed origins (leave empty for defaults: localhost + clinxia.vercel.app)
ALLOWED_ORIGINS=https://seu-app.vercel.app,http://localhost:5173
FRONTEND_URL=https://seu-app.vercel.app

# --- AI Providers for WhatsApp Bot ---
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# --- Gemini AI (optional) ---
GEMINI_API_KEY=

# --- WhatsApp (Baileys) ---
# No env needed - credentials stored in Supabase

# --- Logging ---
LOG_LEVEL=info
